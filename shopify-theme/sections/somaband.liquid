      <!-- ============ EXPERTEN-WALL ============ -->
      <div class="sb-part sb-experts">
        <div class="sb-experts__head">
          <h2 class="sb-h2">Von Profis empfohlen.</h2>
          <p class="sb-experts__sub">Schlafexperten, medizinisches Fachpersonal und Sportler über SomaBand.</p>
        </div>

        {% assign e_names = "Dr. Sophie Reinhardt,Marcus Lehmann,Dr. Michael Harms,Mike Turner,Ethan Brooks,Ryan Carter,Dr. Anna Wenzel,Tobias Krüger,Lena Sommer,Dr. Jonas Feld" | split: "," %}
        {% assign e_roles = "Schlafmedizinerin,Leiter Fitness,Hörgeräteakustiker,Bauleiter,Biohacker,Chef-Skilehrer,Kinderärztin,Feuerwehrmann,Krankenschwester,Neurologe" | split: "," %}
        {% assign e_quotes = "Für Eltern mit kleinen Kindern ist ungestörter Schlaf entscheidend. SomaBand weckt sanft, ohne dass die ganze Familie mit aufwacht.|Ein geregelter Start in den Tag entscheidet über das Training. Meine Sportler kommen damit zuverlässig aus dem Bett.|Für gehörlose und schwerhörige Menschen sind akustische Wecker ungeeignet. Ich empfehle vibrationsbasierte Lösungen wie diese.|Ich muss früh raus, meine Familie nicht. Endlich dröhnt kein Wecker mehr durchs ganze Haus.|Das Smartphone aus dem Schlafzimmer zu verbannen ist einer der schnellsten Wege zu besserem Schlaf. Damit geht das.|Zwischen Reisen, Höhenlagen und Wettkampftagen ist Schlaf das A und O. Ein leises Aufwachen schont die Regeneration.|Kinder wachen bei jedem Alarm mit auf. Eltern, die auf Vibration umstellen, berichten von deutlich ruhigeren Morgen.|24-Stunden-Schichten, Familie zuhause. Ich werde geweckt, sonst niemand. Genau so muss das sein.|Nachtdienst heißt tagsüber schlafen. Das Band holt mich raus, ohne dass mein Partner wach wird.|Abrupte Weckreize erhöhen kurzfristig Stresshormone. Ein taktiles Signal ist deutlich schonender." | split: "|" %}

        <div class="sb-experts__wall" data-experts>
          <div class="sb-expcol" data-expcol style="--sb-dur: 46s">
            {% for i in (0..4) %}
              <figure class="sb-expert">
                <blockquote>{{ e_quotes[i] }}</blockquote>
                <figcaption>
                  {% assign expert_photo_number = i | plus: 1 %}
                  {% capture expert_photo_setting %}expert_photo_{{ expert_photo_number }}{% endcapture %}
                  {% assign expert_photo = section.settings[expert_photo_setting] %}
                  {% if expert_photo != blank %}
                    {{ expert_photo
                      | image_url: width: 120
                      | image_tag:
                        class: 'sb-expert__photo',
                        widths: '64, 84, 120',
                        sizes: '42px',
                        alt: e_names[i],
                        loading: 'lazy',
                        fetchpriority: 'low',
                        decoding: 'async',
                        width: 42,
                        height: 42
                    }}
                  {% else %}
                    <span class="sb-expert__photo sb-profile-placeholder" aria-hidden="true">{{ e_names[i] | slice: 0 }}</span>
                  {% endif %}
                  <span>
                    <strong>{{ e_names[i] }}
                      <svg class="sb-expert__check" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.5 2.5 5-5.5"/></svg>
                    </strong>
                    <span>{{ e_roles[i] }}</span>
                  </span>
                </figcaption>
              </figure>
            {% endfor %}
          </div>

          <div class="sb-expcol" data-expcol style="--sb-dur: 54s">
            {% for i in (5..9) %}
              <figure class="sb-expert">
                <blockquote>{{ e_quotes[i] }}</blockquote>
                <figcaption>
                  {% assign expert_photo_number = i | plus: 1 %}
                  {% capture expert_photo_setting %}expert_photo_{{ expert_photo_number }}{% endcapture %}
                  {% assign expert_photo = section.settings[expert_photo_setting] %}
                  {% if expert_photo != blank %}
                    {{ expert_photo
                      | image_url: width: 120
                      | image_tag:
                        class: 'sb-expert__photo',
                        widths: '64, 84, 120',
                        sizes: '42px',
                        alt: e_names[i],
                        loading: 'lazy',
                        fetchpriority: 'low',
                        decoding: 'async',
                        width: 42,
                        height: 42
                    }}
                  {% else %}
                    <span class="sb-expert__photo sb-profile-placeholder" aria-hidden="true">{{ e_names[i] | slice: 0 }}</span>
                  {% endif %}
                  <span>
                    <strong>{{ e_names[i] }}
                      <svg class="sb-expert__check" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 12.5l2.5 2.5 5-5.5"/></svg>
                    </strong>
                    <span>{{ e_roles[i] }}</span>
                  </span>
                </figcaption>
              </figure>
            {% endfor %}
          </div>
        </div>
      </div>


        <!-- FAQ -->
        <div class="sb-part">
          <h2 class="sb-h2 sb-h2--light">Kurz beantwortet.</h2>

          <div class="sb-faq">
            {% if section.settings.faq_extra_q != blank %}
              <details class="sb-faq__item" open>
                <summary>{{ section.settings.faq_extra_q }}</summary>
                <div class="sb-faq__body">
                  <p>{{ section.settings.faq_extra_a }}</p>
                </div>
              </details>
            {% endif %}

            <details class="sb-faq__item" {% if section.settings.faq_extra_q == blank %}open{% endif %}>
              <summary>Funktioniert SomaBand auch bei sehr tiefem Schlaf?</summary>
              <div class="sb-faq__body">
                <p>Ja – genau dafür ist es entwickelt. Einen Ton kann man überhören, eine kräftige Vibration am Körper nicht.</p>
              </div>
            </details>

            <details class="sb-faq__item">
              <summary>Wie unterscheidet es sich von einer Smartwatch?</summary>
              <div class="sb-faq__body">
                <p>Eine Smartwatch vibriert dezent für Benachrichtigungen – zu schwach als Weckreiz. SomaBand macht eine Sache richtig: dich wecken. Ohne App, ohne Konto, ohne tägliches Laden.</p>
              </div>
            </details>

            <details class="sb-faq__item">
              <summary>Was ist, wenn es bei mir nicht funktioniert?</summary>
              <div class="sb-faq__body">
                <p>Du hast 30 Nächte Zeit zum Testen. Passt es nicht, schickst du es zurück und bekommst dein Geld zurück.</p>
              </div>
            </details>

            <details class="sb-faq__item">
              <summary>Wann kommt meine Bestellung an?</summary>
              <div class="sb-faq__body">
                <p>Wir versenden innerhalb von 1–2 Werktagen aus Deutschland per DHL – in der Regel ist dein SomaBand nach wenigen Tagen bei dir. Ab 50&nbsp;€ Bestellwert versenden wir kostenlos und legen einen Lavendel-Duftbeutel dazu.</p>
              </div>
            </details>
          </div>
        </div>

        <!-- FINAL CTA -->
        <div class="sb-final">
          <h2 class="sb-h2 sb-h2--light">Morgen früh zum ersten Mal ruhig aufwachen.</h2>
          <button type="button" class="sb-btn sb-btn--light sb-btn--large" data-scroll-to-buy>Jetzt sichern</button>
        </div>

      </div>
