                <td><span class="sb-mark sb-mark--no" aria-label="Nein"><svg viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12"/></svg></span></td>
                <td><span class="sb-val sb-val--mid">teilweise</span></td>
