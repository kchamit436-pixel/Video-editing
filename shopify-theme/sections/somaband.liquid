      }
      #sb-page-{{ section.id }} .sb-hero-trust__item:nth-child(odd):last-child {
        grid-column: 1 / -1;
      }

      #sb-page-{{ section.id }} .sb-purchase-reward {
        padding: 13px 14px 13px 16px; gap: 11px;
      }
      #sb-page-{{ section.id }} .sb-purchase-reward__icon { width: 30px; height: 30px; flex: 0 0 30px; }
      #sb-page-{{ section.id }} .sb-purchase-reward__text strong { font-size: 13.5px; }
      #sb-page-{{ section.id }} .sb-purchase-reward__text > span { font-size: 12px; }

      #sb-page-{{ section.id }} .sb-ship { padding: 15px 10px 13px; }
      #sb-page-{{ section.id }} .sb-ship__label { font-size: 12px; }
      #sb-page-{{ section.id }} .sb-ship__date { font-size: 11px; }
      #sb-page-{{ section.id }} .sb-ship__note { font-size: 12px; }

      #sb-page-{{ section.id }} .sb-swipe--reviews .sb-review { padding: 20px; }
      #sb-page-{{ section.id }} .sb-review__quotemark { font-size: 62px; right: 10px; }

      #sb-page-{{ section.id }} .sb-darkzone { margin-top: 68px; padding-top: 56px; }
      #sb-page-{{ section.id }} .sb-darkzone .sb-guarantee { margin-top: 68px; }
    }
  </style>

  <script>
    (function() {
      var root = document.getElementById('sb-page-{{ section.id }}');
      if (!root) return;

      // Erst wenn das Skript wirklich läuft, werden Reveal-Elemente ausgeblendet.
      root.classList.add('is-js');

      // Jeder Baustein läuft gekapselt: Ein Fehler darf nie den Rest der Seite killen.
      function safe(fn) { try { fn(); } catch (e) {} }

      /* ---------- Reveal-Animation ---------- */
      safe(function() {
        var revealEls = root.querySelectorAll('[data-reveal]');
        if (!revealEls.length) return;
        if (!('IntersectionObserver' in window)) {
          revealEls.forEach(function(el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
        revealEls.forEach(function(el) { io.observe(el); });
      });

      /* ---------- Galerie ----------
         Wichtig: Die Slides liegen auf display:none. Bilder mit
         loading="lazy" werden in so einem Container NIE geladen, weil der
         Browser keine Fläche zum Beobachten hat. Deshalb schalten wir den
         aktiven Slide und seine beiden Nachbarn auf eager um. */
      safe(function() {
        var slides = root.querySelectorAll('[data-gallery-slide]');
        var thumbs = root.querySelectorAll('[data-gallery-thumb]');
        var prevBtn = root.querySelector('[data-gallery-prev]');
        var nextBtn = root.querySelector('[data-gallery-next]');
        var viewport = root.querySelector('[data-gallery-viewport]');
        if (!slides.length) return;

        var index = 0;

        function preloadAround(i) {
          [i - 1, i, i + 1].forEach(function(k) {
            var slide = slides[(k + slides.length) % slides.length];
            if (!slide) return;
            var img = slide.querySelector('img');
            if (img && img.loading === 'lazy') {
              img.loading = 'eager';
              img.fetchPriority = 'auto';
            }
          });
        }

        function show(i) {
          if (i < 0) i = slides.length - 1;
          if (i >= slides.length) i = 0;
          index = i;
          preloadAround(i);
          slides.forEach(function(slide, k) { slide.classList.toggle('is-active', k === i); });
          thumbs.forEach(function(thumb, k) { thumb.classList.toggle('is-active', k === i); });
        }

        thumbs.forEach(function(thumb) {
          thumb.addEventListener('click', function() {
            show(parseInt(thumb.getAttribute('data-gallery-index'), 10) || 0);
          });
        });

        if (prevBtn) prevBtn.addEventListener('click', function() { show(index - 1); });
        if (nextBtn) nextBtn.addEventListener('click', function() { show(index + 1); });

        if (viewport) {
          var touchX = 0, touchY = 0;
          viewport.addEventListener('touchstart', function(e) {
            touchX = e.changedTouches[0].clientX;
            touchY = e.changedTouches[0].clientY;
          }, { passive: true });
          viewport.addEventListener('touchend', function(e) {
            var dx = touchX - e.changedTouches[0].clientX;
            var dy = touchY - e.changedTouches[0].clientY;
            // Nur horizontal wischen – vertikales Scrollen bleibt unangetastet.
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
              show(dx > 0 ? index + 1 : index - 1);
            }
          }, { passive: true });
        }

        show(0);
      });

      /* ---------- Countdown bis Mitternacht ----------
         Rechnet nicht weiter, solange der Tab im Hintergrund liegt. */
      safe(function() {
        var countdownNode = root.querySelector('[data-countdown]');
        if (!countdownNode) return;

        function pad(n) { return n < 10 ? '0' + n : String(n); }

        function tick() {
          if (document.hidden) return;
          var now = new Date();
          var midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1, 0, 0, 0, 0);
          var distance = Math.max(0, midnight.getTime() - now.getTime());
          var hours = Math.floor(distance / 3600000);
          var minutes = Math.floor((distance % 3600000) / 60000);
          var seconds = Math.floor((distance % 60000) / 1000);
          countdownNode.textContent = pad(hours) + ':' + pad(minutes) + ':' + pad(seconds);
        }

        tick();
        setInterval(tick, 1000);
        document.addEventListener('visibilitychange', tick);
      });

      /* ---------- Lieferzeit-Grafik ----------
         Versand 1–2 Werktage, Laufzeit 1–2 Werktage. Wochenenden
         werden übersprungen. Bestellungen nach 15 Uhr gehen erst am
         nächsten Werktag raus. */
      safe(function() {
        var ship = root.querySelector('[data-ship]');
        if (!ship) return;

        var now = new Date();

        function addDays(date, days) {
          var d = new Date(date.getTime());
          d.setDate(d.getDate() + days);
          return d;
        }

        function fmt(d) {
          return d.toLocaleDateString('de-DE', { weekday: 'short', day: 'numeric', month: 'short' });
        }

        function range(a, b) {
          if (a.getTime() === b.getTime()) return fmt(a);
          return fmt(a) + ' – ' + fmt(b);
        }

        // Kalendertage, kein Annahmeschluss: verschickt in 1–2 Tagen,
        // danach 2 Tage Laufzeit.
        var base = new Date(now.getTime());

        var sendFrom = addDays(base, 1);
        var sendTo = addDays(base, 2);
        var deliverFrom = addDays(sendFrom, 2);
        var deliverTo = addDays(sendTo, 2);

        function set(selector, text) {
          var node = ship.querySelector(selector);
          if (node) node.textContent = text;
        }

        set('[data-ship-order]', 'heute, ' + now.toLocaleDateString('de-DE', { day: 'numeric', month: 'short' }));
        set('[data-ship-send]', range(sendFrom, sendTo));
        set('[data-ship-deliver]', range(deliverFrom, deliverTo));
        set('[data-ship-range]', range(deliverFrom, deliverTo));
      });

      /* ---------- CTA-Buttons, die zur Buy-Box scrollen ---------- */
      safe(function() {
        var target = root.querySelector('.sb-sternify-app-slot') || root.querySelector('.sb-form') || root;
        root.querySelectorAll('[data-scroll-to-buy]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          });
        });
      });

      /* ---------- Kaufbuttons: Weiterleitung + Doppelklick-Schutz ----------
         "Jetzt sichern" soll direkt in den Checkout führen.

         Wichtig: Sternify fängt den Kauf ab und legt per JavaScript in den
         Warenkorb. Es gibt dabei KEINE Seitennavigation, deshalb greift das
         Feld return_to nicht. Wir warten hier darauf, dass sich der Warenkorb
         tatsächlich ändert, und leiten erst dann selbst weiter.
         return_to bleibt als Absicherung drin, falls Sternify einmal nicht
         lädt und der Browser das Formular ganz normal abschickt.

         Der Doppelklick-Schutz hängt am submit-Event, nicht am click-Event:
         ein im click-Handler deaktivierter Button zählt nicht mehr als
         Submitter, dann fehlt sein Name im Request und der Kauf schlägt fehl. */
      safe(function() {
        var form = root.querySelector('.sb-form');
        if (!form) return;

        var cartJsUrl = '{{ routes.cart_url }}.js';
        var returnTo = form.querySelector('[data-return-to]');
        var submitButtons = form.querySelectorAll('button[type="submit"]');
        var submitting = false;
        var redirectTo = null;
        var baseline = null;

        function setBusy(state) {
          submitButtons.forEach(function(btn) {
            if (state) {
              btn.setAttribute('aria-busy', 'true');
            } else {
              btn.removeAttribute('aria-busy');
            }
          });
        }

        function release() {
          submitting = false;
          setBusy(false);
        }

        function readCart() {
          return fetch(cartJsUrl, { headers: { Accept: 'application/json' }, cache: 'no-store' })
            .then(function(response) { return response.ok ? response.json() : null; })
            .catch(function() { return null; });
        }

        // Ausgangsstand des Warenkorbs merken, um die Änderung zu erkennen
        readCart().then(function(cart) {
          if (cart) baseline = cart.item_count;
        });

        form.querySelectorAll('[data-buy-target]').forEach(function(btn) {
          btn.addEventListener('click', function() {
            if (returnTo) returnTo.value = btn.getAttribute('data-buy-target');
            // Nur "Jetzt sichern" leitet aktiv weiter. "Zum Warenkorb" lässt
            // dem Theme bzw. Sternify den Vortritt (z. B. Warenkorb-Drawer).
            redirectTo = btn.hasAttribute('data-buy-now') ? btn.getAttribute('data-buy-target') : null;
          });
        });

        form.addEventListener('submit', function(event) {
          if (submitting) {
            event.preventDefault();
            return;
          }
          submitting = true;
          setBusy(true);

          if (!redirectTo) {
            window.setTimeout(release, 6000);
            return;
          }

          var tries = 0;
          var poll = window.setInterval(function() {
            tries += 1;

            readCart().then(function(cart) {
              if (!cart) return;

              if (baseline === null) {
                baseline = cart.item_count;
                return;
              }

              if (cart.item_count !== baseline) {
                window.clearInterval(poll);
                // Kurze Pause, falls Sternify mehrere Positionen nacheinander legt
                window.setTimeout(function() {
                  window.location.href = redirectTo;
                }, 400);
              } else if (tries >= 20) {
                // Nach ca. 8 s aufgeben und den Button wieder freigeben
                window.clearInterval(poll);
                release();
              }
            });
          }, 400);
        });

        // Kommt der Kunde per Zurück-Taste hierher, Sperre sofort lösen
        window.addEventListener('pageshow', function() {
          release();
          readCart().then(function(cart) {
            if (cart) baseline = cart.item_count;
          });
        });
      });

      /* ---------- Swiper-Dots ---------- */
      safe(function() {
        root.querySelectorAll('[data-swiper]').forEach(function(swiper) {
          var dotsWrap = swiper.parentElement.querySelector('[data-swiper-dots]');
          if (!dotsWrap) return;

          var items = Array.prototype.slice.call(swiper.children);
          if (!items.length) return;

          dotsWrap.innerHTML = '';
          items.forEach(function(_, i) {
            var dot = document.createElement('span');
            dot.className = 'sb-dot' + (i === 0 ? ' is-active' : '');
            dotsWrap.appendChild(dot);
          });

          var dots = dotsWrap.children;
          var ticking = false;

          swiper.addEventListener('scroll', function() {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(function() {
              var gap = parseFloat(getComputedStyle(swiper).columnGap) || 14;
              var itemWidth = items[0].getBoundingClientRect().width + gap;
              var i = Math.min(items.length - 1, Math.max(0, Math.round(swiper.scrollLeft / itemWidth)));
              for (var d = 0; d < dots.length; d++) {
                dots[d].classList.toggle('is-active', d === i);
              }
              ticking = false;
            });
          }, { passive: true });
        });
      });

      /* ---------- Experten-Wall ----------
         20 geklonte Karten mit will-change laufen sonst dauerhaft, auch
         wenn der Block gar nicht im Bild ist. Wir pausieren sie außerhalb
         des Viewports – das spart auf Mittelklasse-Android spürbar Last. */
      safe(function() {
        // Auf Mobil alle Karten in eine Spalte zusammenführen
        var expertColumns = Array.prototype.slice.call(root.querySelectorAll('[data-expcol]'));
        if (window.innerWidth <= 749 && expertColumns.length > 1) {
          var firstColumn = expertColumns[0];
          expertColumns.slice(1).forEach(function(col) {
            Array.prototype.slice.call(col.children).forEach(function(card) {
              firstColumn.appendChild(card);
            });
            col.remove();
          });
        }

        // Inhalt duplizieren für den nahtlosen Loop
        root.querySelectorAll('[data-expcol]').forEach(function(col) {
          if (col.classList.contains('is-loop-ready')) return;
          Array.prototype.slice.call(col.children).forEach(function(card) {
            var clone = card.cloneNode(true);
            clone.setAttribute('aria-hidden', 'true');
            col.appendChild(clone);
          });
          col.classList.add('is-loop-ready');
        });

        // Animation nur laufen lassen, solange die Wall sichtbar ist
        var wall = root.querySelector('[data-experts]');
        if (!wall || !('IntersectionObserver' in window)) return;

        var columns = root.querySelectorAll('[data-expcol]');
        columns.forEach(function(col) { col.classList.add('is-paused'); });

        var wallIo = new IntersectionObserver(function(entries) {
          var visible = entries[0].isIntersecting;
          columns.forEach(function(col) { col.classList.toggle('is-paused', !visible); });
        }, { threshold: 0 });

        wallIo.observe(wall);
      });

      /* ---------- Mobile Sticky ----------
         Früher lief hier ein Scroll-Handler mit getBoundingClientRect. Das
         erzwingt bei JEDEM Scroll-Event ein synchrones Layout und ist auf
         Mittelklasse-Android eine der häufigsten Ruckelursachen. Der
         IntersectionObserver macht dasselbe ohne Layout-Kosten.
         Die Desktop-Abfrage entfällt: .sb-sticky__inner steht per CSS
         ohnehin nur unter 750px auf display:flex. */
      safe(function() {
        var sticky = root.querySelector('[data-mobile-sticky]');
        var form = root.querySelector('.sb-form');
        if (!sticky || !form) return;

        if (!('IntersectionObserver' in window)) {
          sticky.classList.add('is-visible');
          return;
        }

        var io = new IntersectionObserver(function(entries) {
          var entry = entries[0];
          sticky.classList.toggle(
            'is-visible',
            !entry.isIntersecting && entry.boundingClientRect.top < 0
          );
        }, { threshold: 0 });

        io.observe(form);
      });
    })();
  </script>
{% endif %}

