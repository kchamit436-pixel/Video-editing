    <!-- MOBILE STICKY -->
    <div class="sb-sticky" data-mobile-sticky>
      <div class="sb-sticky__inner">
        <div class="sb-sticky__price">
          <span>{% if current_product.variants.size > 1 %}ab {{ current_product.price_min | money }}{% else %}{{ current_product.price | money }}{% endif %}</span>
          <small>inkl. MwSt.</small>
        </div>
        <button type="button" class="sb-btn sb-btn--primary sb-sticky__btn" data-scroll-to-buy>
          Jetzt sichern
        </button>
      </div>
    </div>
  </section>

  <style>
    #sb-page-{{ section.id }} {
      --navy: #0B2350;
      --navy-deep: #071835;
      --blue: #2563EB;
      --sky: #8FB4FF;
      --ink: #0E1526;
      --muted: #5C6B84;
      --faint: #93A1B8;
      --line: #E2E8F2;
      --surface: #F3F7FC;
      --gold: #E8A33D;
      --green: #00B67A;
      --green-deep: #00734F;
      --red: #D70015;
      --radius: 16px;
      --font-display: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
      --font-body: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "Segoe UI", Roboto, Arial, sans-serif;
      background: #ffffff;
      color: var(--ink);
      font-family: var(--font-body);
      padding: 40px 20px 0;
      overflow: clip;
      -webkit-font-smoothing: antialiased;
    }

    #sb-page-{{ section.id }} * { box-sizing: border-box; }
    #sb-page-{{ section.id }} .is-hidden { display: none !important; }
    #sb-page-{{ section.id }} .sb__inner { max-width: 1180px; margin: 0 auto; }

    /* ---------- Typography ---------- */
    #sb-page-{{ section.id }} .sb-h2 {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(26px, 3.2vw, 40px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-weight: 700;
      color: var(--navy);
      max-width: 24ch;
    }
    #sb-page-{{ section.id }} .sb-h2--light { color: #ffffff; }

    /* ---------- Flow-Layout ---------- */
    #sb-page-{{ section.id }} .sb-part { margin-top: 88px; }

    /* ---------- Hero ---------- */
    #sb-page-{{ section.id }} .sb-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(400px, 0.95fr);
      gap: 52px;
      align-items: start;
    }

    #sb-page-{{ section.id }} .sb-gallery { min-width: 0; }
    #sb-page-{{ section.id }} .sb-gallery__main { position: relative; }
    #sb-page-{{ section.id }} .sb-gallery__viewport {
      position: relative; width: 100%; aspect-ratio: 1 / 1;
      display: flex; align-items: center; justify-content: center;
      overflow: hidden; border-radius: var(--radius); background: #ffffff;
    }
    #sb-page-{{ section.id }} .sb-gallery__slide {
      display: none; width: 100%; height: 100%;
      align-items: center; justify-content: center;
    }
    #sb-page-{{ section.id }} .sb-gallery__slide.is-active { display: flex; }
    #sb-page-{{ section.id }} .sb-gallery__slide img {
      width: 100%; height: 100%; object-fit: contain; display: block;
      user-select: none; -webkit-user-drag: none;
    }
    #sb-page-{{ section.id }} .sb-gallery__nav {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
      width: 42px; height: 42px; border-radius: 999px;
      border: 1px solid var(--line); background: #ffffff; color: var(--navy);
      cursor: pointer; font-size: 24px; line-height: 1;
      display: inline-flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 14px rgba(11,35,80,0.10);
    }
    #sb-page-{{ section.id }} .sb-gallery__nav--prev { left: 10px; }
    #sb-page-{{ section.id }} .sb-gallery__nav--next { right: 10px; }
    #sb-page-{{ section.id }} .sb-gallery__thumbs { display: flex; gap: 10px; margin-top: 14px; flex-wrap: wrap; }
    #sb-page-{{ section.id }} .sb-gallery__thumb {
      width: 62px; height: 62px; padding: 0;
      border: 1.5px solid var(--line); border-radius: 12px;
      overflow: hidden; background: #ffffff; cursor: pointer;
    }
    #sb-page-{{ section.id }} .sb-gallery__thumb.is-active { border-color: var(--navy); }
    #sb-page-{{ section.id }} .sb-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    #sb-page-{{ section.id }} .sb-ai-note {
      margin: 7px 0 0;
      font-size: 10.5px;
      line-height: 1.35;
      color: var(--faint);
      letter-spacing: -0.005em;
    }

    /* ---------- Buy box ---------- */
    #sb-page-{{ section.id }} .sb-buy { min-width: 0; }

    #sb-page-{{ section.id }} .sb-sternify-app-slot {
      width: 100%;
      margin-top: 16px;
      padding: 0;
    }
    #sb-page-{{ section.id }} .sb-sternify-app-block,
    #sb-page-{{ section.id }} .sb-sternify-app-block > *,
    #sb-page-{{ section.id }} .sb-sternify-app-slot .shopify-block {
      width: 100%;
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
    }

    /* Proof: Einzeiliges Rating + Experten-Badge */
    #sb-page-{{ section.id }} .sb-proof { margin-bottom: 16px; display: grid; gap: 9px; }
    #sb-page-{{ section.id }} .sb-proof__rating {
      display: flex; align-items: center; gap: 8px;
    }
    #sb-page-{{ section.id }} .sb-stars {
      color: var(--gold); letter-spacing: 0.06em; font-size: 14px; line-height: 1;
    }
    #sb-page-{{ section.id }} .sb-proof__text {
      font-size: 13px; color: var(--muted); line-height: 1;
    }
    #sb-page-{{ section.id }} .sb-proof__text strong {
      font-family: var(--font-display);
      color: var(--ink); font-weight: 700; letter-spacing: -0.01em;
    }

    #sb-page-{{ section.id }} .sb-proof__expert {
      display: inline-flex; align-items: center; gap: 7px;
      width: fit-content;
      font-size: 12.5px; font-weight: 650; color: var(--navy);
      border-bottom: 1px solid var(--line);
      padding-bottom: 10px;
    }
    #sb-page-{{ section.id }} .sb-proof__expert svg { width: 15px; height: 15px; flex: 0 0 auto; }
    #sb-page-{{ section.id }} .sb-proof__expert svg path {
      fill: none; stroke: var(--green); stroke-width: 2;
      stroke-linecap: round; stroke-linejoin: round;
    }

    #sb-page-{{ section.id }} .sb-buy__title {
      margin: 0;
      font-family: var(--font-display);
      font-size: clamp(40px, 4.6vw, 58px);
      line-height: 1.0;
      letter-spacing: -0.035em;
      font-weight: 800;
      color: var(--navy);
      display: grid;
      gap: 10px;
    }
    #sb-page-{{ section.id }} .sb-buy__tagline {
      font-size: clamp(20px, 2.1vw, 26px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--ink);
    }
    #sb-page-{{ section.id }} .sb-buy__tagline em { font-style: normal; color: var(--blue); }

    #sb-page-{{ section.id }} .sb-buy__sub {
      margin: 14px 0 0;
      font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 42ch;
    }

    #sb-page-{{ section.id }} .sb-hero-trust {
      margin-top: 18px;
      display: flex; flex-wrap: wrap; gap: 8px 18px;
    }
    #sb-page-{{ section.id }} .sb-hero-trust__item {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 13px; font-weight: 600; color: var(--navy);
      line-height: 1.3;
    }
    #sb-page-{{ section.id }} .sb-hero-trust__item svg {
      width: 15px; height: 15px; flex: 0 0 auto;
    }
    #sb-page-{{ section.id }} .sb-hero-trust__item svg path,
    #sb-page-{{ section.id }} .sb-hero-trust__item svg circle,
    #sb-page-{{ section.id }} .sb-hero-trust__item svg rect {
      fill: none; stroke: var(--green); stroke-width: 2;
      stroke-linecap: round; stroke-linejoin: round;
    }

    /* ---------- Versand-/Geschenk-Hinweis (jetzt über der Auswahl) ---------- */
    #sb-page-{{ section.id }} .sb-purchase-reward {
      display: flex;
      align-items: center;
      gap: 11px;
      margin: 18px 0 0;
      padding: 12px 14px;
      border: 1px solid rgba(0,182,122,0.28);
      border-radius: 12px;
      background: linear-gradient(180deg, #F2FBF7 0%, #EAF7F1 100%);
      color: #2C4A3E;
      font-size: 13px;
      line-height: 1.4;
    }
    #sb-page-{{ section.id }} .sb-purchase-reward strong {
      color: var(--green-deep);
      font-weight: 750;
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__icon {
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 9px;
      background: rgba(0,182,122,0.13);
      color: var(--green-deep);
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__icon svg {
      width: 16px;
      height: 16px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.65;
      stroke-linecap: round;
