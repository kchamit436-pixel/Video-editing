    /* ---------- Mobil ---------- */
    /* Auf Mobil stehen die Hero-Spalten untereinander. Der 60px-Abstand
       von oben wird dort zur Lücke zwischen KI-Hinweis und Buy Box. */
    @media (max-width: 999px) {
      #sb-page-{{ section.id }} .sb-hero { gap: 26px; }
