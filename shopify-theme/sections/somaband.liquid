      </div>

      <!-- ============ 100 % AUFWACHGARANTIE (BILD) ============ -->
      <div class="sb-guarantee" data-reveal>
        {% if section.settings.guarantee_image != blank %}
          {% assign guarantee_alt = section.settings.guarantee_image.alt | default: '100 % Aufwach-Garantie – Teste das SomaBand 30 Nächte risikofrei' %}
