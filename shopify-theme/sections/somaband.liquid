      aspect-ratio: 1 / 1;
      border-radius: 20px;
      overflow: hidden;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.10);
    }
    #sb-page-{{ section.id }} .sb-gal__card img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    #sb-page-{{ section.id }} .sb-gal__placeholder {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      text-align: center; line-height: 1.5;
      color: rgba(255,255,255,0.42); font-size: 13px; font-weight: 700;
      border: 1.5px dashed rgba(255,255,255,0.16);
      border-radius: 20px;
    }
    #sb-page-{{ section.id }} .sb-gal__cap {
      position: absolute; left: 16px; right: 16px; bottom: 14px;
      color: #ffffff; font-size: 13px; font-weight: 600;
      text-shadow: 0 2px 12px rgba(0,0,0,0.55);
    }

    /* FAQ auf Dunkel */
    #sb-page-{{ section.id }} .sb-darkzone .sb-faq__item { border-top-color: rgba(255,255,255,0.14); }
    #sb-page-{{ section.id }} .sb-darkzone .sb-faq__item:last-child { border-bottom-color: rgba(255,255,255,0.14); }
    #sb-page-{{ section.id }} .sb-darkzone .sb-faq__item summary { color: #ffffff; }
    #sb-page-{{ section.id }} .sb-darkzone .sb-faq__item summary::after { color: var(--sky); }
    #sb-page-{{ section.id }} .sb-darkzone .sb-faq__body p { color: rgba(255,255,255,0.68); }

    /* ---------- FAQ ---------- */
    #sb-page-{{ section.id }} .sb-faq { margin-top: 30px; max-width: 780px; display: grid; gap: 0; }
    #sb-page-{{ section.id }} .sb-faq__item { border-top: 1px solid var(--line); }
    #sb-page-{{ section.id }} .sb-faq__item:last-child { border-bottom: 1px solid var(--line); }
    #sb-page-{{ section.id }} .sb-faq__item summary {
      list-style: none; cursor: pointer; min-height: 58px;
      display: flex; align-items: center; justify-content: space-between; gap: 14px;
      font-family: var(--font-display);
      font-size: 15px; font-weight: 600; letter-spacing: -0.01em;
      color: var(--navy); padding: 8px 0;
    }
    #sb-page-{{ section.id }} .sb-faq__item summary::-webkit-details-marker { display: none; }
    #sb-page-{{ section.id }} .sb-faq__item summary::after {
      content: "+"; font-size: 22px; font-weight: 400; color: var(--navy); flex: 0 0 auto;
    }
    #sb-page-{{ section.id }} .sb-faq__item[open] summary::after { content: "−"; }
    #sb-page-{{ section.id }} .sb-faq__body { padding: 0 0 20px; max-width: 64ch; }
    #sb-page-{{ section.id }} .sb-faq__body p {
      margin: 0; font-size: 14.5px; line-height: 1.65; color: var(--muted);
    }

    /* ---------- Final CTA ---------- */
    #sb-page-{{ section.id }} .sb-final {
      margin-top: 90px;
      text-align: center;
      padding: 40px 20px 96px;
      position: relative;
    }
    #sb-page-{{ section.id }} .sb-final .sb-h2 { margin: 0 auto; }
    #sb-page-{{ section.id }} .sb-final .sb-btn { margin-top: 26px; }

    /* ---------- Mobile sticky ---------- */
    #sb-page-{{ section.id }} .sb-sticky {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 9999;
      pointer-events: none; opacity: 0; transform: translateY(100%);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    #sb-page-{{ section.id }} .sb-sticky.is-visible { opacity: 1; transform: translateY(0); }
    #sb-page-{{ section.id }} .sb-sticky__inner {
      pointer-events: auto; display: none;
      align-items: center; justify-content: space-between; gap: 12px;
      background: #ffffff; border-top: 1px solid var(--line);
      box-shadow: 0 -8px 24px rgba(11,35,80,0.10);
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    }
    #sb-page-{{ section.id }} .sb-sticky__price { display: grid; gap: 1px; }
    #sb-page-{{ section.id }} .sb-sticky__price span {
      font-family: var(--font-display);
      font-size: 18px; font-weight: 700; letter-spacing: -0.02em; color: var(--navy);
    }
    #sb-page-{{ section.id }} .sb-sticky__price small { color: var(--muted); font-size: 11.5px; }
    #sb-page-{{ section.id }} .sb-sticky__btn { min-width: 165px; min-height: 50px; }

    /* ---------- Desktop: Swiper → Grid ---------- */
    @media (min-width: 1000px) {
      #sb-page-{{ section.id }} .sb-swipe--strip {
        grid-auto-flow: row; grid-template-columns: repeat(3, 1fr);
        grid-auto-columns: unset; overflow: visible;
        gap: 24px;
      }
      #sb-page-{{ section.id }} .sb-swipe--gal {
        grid-auto-flow: row; grid-template-columns: repeat(3, 1fr);
        grid-auto-columns: unset; overflow: visible;
        gap: 20px; margin-top: 0;
      }
      /* Reviews bleiben ein Karussell (15 Stück) */
      #sb-page-{{ section.id }} .sb-swipe--reviews { grid-auto-columns: calc((100% - 54px) / 4); gap: 18px; }

      #sb-page-{{ section.id }} .sb-dots { display: none; }
      #sb-page-{{ section.id }} .sb-swipe--reviews ~ .sb-dots { display: flex; }
      #sb-page-{{ section.id }} .sb-swipe { margin-top: 32px; }
    }

    /* ---------- Responsive ---------- */
    @media (max-width: 999px) {
      #sb-page-{{ section.id }} .sb-hero { grid-template-columns: 1fr; gap: 24px; }
      #sb-page-{{ section.id }} .sb-experts__wall {
        grid-template-columns: repeat(2, 1fr); height: 580px;
      }
    }

    @media (max-width: 749px) {
      #sb-page-{{ section.id }} { padding: 14px 14px 0; }

      #sb-page-{{ section.id }} .sb-gallery__viewport { aspect-ratio: 1 / 1; }
      #sb-page-{{ section.id }} .sb-gallery__thumbs { flex-wrap: nowrap; overflow-x: auto; gap: 8px; }
      #sb-page-{{ section.id }} .sb-gallery__thumb { width: 50px; height: 50px; flex: 0 0 auto; }
      #sb-page-{{ section.id }} .sb-gallery__nav { display: none; }

      #sb-page-{{ section.id }} .sb-proof { gap: 8px; margin-bottom: 14px; }
      #sb-page-{{ section.id }} .sb-stars { font-size: 13px; letter-spacing: 0.05em; }
      #sb-page-{{ section.id }} .sb-proof__text { font-size: 12.5px; }

      #sb-page-{{ section.id }} .sb-buy__title { font-size: 40px; gap: 8px; }
      #sb-page-{{ section.id }} .sb-buy__tagline { font-size: 20px; }
      #sb-page-{{ section.id }} .sb-buy__sub { font-size: 15px; }
      #sb-page-{{ section.id }} .sb-hero-trust { gap: 7px 14px; margin-top: 14px; }
      #sb-page-{{ section.id }} .sb-hero-trust__item { font-size: 12px; }

      #sb-page-{{ section.id }} .sb-purchase-reward {
        margin-top: 14px; padding: 11px 12px; font-size: 12.5px; gap: 10px;
      }

      #sb-page-{{ section.id }} .sb-trust-line {
        white-space: nowrap; font-size: 11.5px; letter-spacing: -0.01em;
      }

      #sb-page-{{ section.id }} .sb-part { margin-top: 48px; }

      #sb-page-{{ section.id }} .sb-rev-head { gap: 14px; }
      #sb-page-{{ section.id }} .sb-tp__box { width: 22px; height: 22px; font-size: 13px; }

      #sb-page-{{ section.id }} .sb-cmp-sub { font-size: 14.5px; }
      #sb-page-{{ section.id }} .sb-compare { min-width: 580px; font-size: 13px; }
      #sb-page-{{ section.id }} .sb-compare tbody th { font-size: 13px; padding: 15px 14px 15px 2px; }
      #sb-page-{{ section.id }} .sb-compare tbody td { padding: 15px 10px; }
      #sb-page-{{ section.id }} .sb-compare__brand { font-size: 15px; }
      #sb-page-{{ section.id }} .sb-mark { width: 24px; height: 24px; }

      #sb-page-{{ section.id }} .sb-experts__wall {
        display: block; height: 500px; margin-top: 30px;
      }
      #sb-page-{{ section.id }} .sb-experts__wall > .sb-expcol:not(:first-child) { display: none; }
      #sb-page-{{ section.id }} .sb-expcol {
        width: 100%; gap: 14px;
        -webkit-animation: none !important;
        animation: none !important;
        -webkit-transform: translate3d(0, 0, 0);
        transform: translate3d(0, 0, 0);
      }
      #sb-page-{{ section.id }} .sb-expcol.is-loop-ready {
        -webkit-animation: sb-scroll-up var(--sb-dur, 50s) linear infinite !important;
        animation: sb-scroll-up var(--sb-dur, 50s) linear infinite !important;
        -webkit-animation-play-state: running !important;
        animation-play-state: running !important;
      }
      #sb-page-{{ section.id }} .sb-expcol.is-loop-ready.is-paused {
        -webkit-animation-play-state: paused !important;
        animation-play-state: paused !important;
      }
      #sb-page-{{ section.id }} .sb-experts__sub { font-size: 14.5px; }
      #sb-page-{{ section.id }} .sb-expert { padding: 18px; }
      #sb-page-{{ section.id }} .sb-expert blockquote { font-size: 14px; }

      #sb-page-{{ section.id }} .sb-darkzone { margin-top: 56px; padding: 44px 14px 0; }
      #sb-page-{{ section.id }} .sb-darkzone .sb-part { margin-top: 52px; }
      #sb-page-{{ section.id }} .sb-final { margin-top: 56px; padding: 24px 6px 110px; }
      #sb-page-{{ section.id }} .sb-final .sb-btn--large { width: 100%; min-width: 0; }

      #sb-page-{{ section.id }} .sb-sticky__inner { display: flex; }
    }

    /* ==========================================================
       FEINSCHLIFF
       Navy = Struktur · Gold = nur Bewertungssterne ·
       Grün = nur Bestätigung. Haarlinien statt Schatten.
       Ab der Vergleichstabelle läuft die Seite auf dunklem Grund.
       ========================================================== */

    #sb-page-{{ section.id }} {
      --line: #E4E8EF;
      --hair: #EDF0F5;
      --muted: #59637A;
      --faint: #8B94A6;
      --gold: #F5A623;
      --d-line: rgba(255,255,255,0.14);
      --d-hair: rgba(255,255,255,0.09);
      --d-text: rgba(255,255,255,0.72);
      --d-faint: rgba(255,255,255,0.48);
    }

    #sb-page-{{ section.id }} .sb-part { margin-top: 112px; }
    #sb-page-{{ section.id }} .sb-hero { gap: 60px; }
    #sb-page-{{ section.id }} .sb-h2 {
      font-size: clamp(27px, 2.9vw, 39px);
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.12;
    }

    /* ---------- Headline mit Schriftwechsel ---------- */
    #sb-page-{{ section.id }} .sb-buy__title {
      display: block;
      font-size: clamp(33px, 3.6vw, 50px);
      line-height: 1.04;
      letter-spacing: -0.03em;
      color: var(--navy);
    }
    #sb-page-{{ section.id }} .sb-buy__title-thin {
      display: block;
      font-weight: 300;
      font-style: italic;
      color: #47587A;
      letter-spacing: -0.015em;
    }
    #sb-page-{{ section.id }} .sb-buy__title-bold {
      display: block;
      font-weight: 800;
      letter-spacing: -0.035em;
    }
    #sb-page-{{ section.id }} .sb-buy__sub {
      margin-top: 16px;
      font-size: 16.5px;
      line-height: 1.6;
      color: #46536B;
      max-width: 44ch;
    }
    #sb-page-{{ section.id }} .sb-buy__sub p { margin: 0; }
    #sb-page-{{ section.id }} .sb-buy__sub p + p { margin-top: 8px; }

    /* Auszeichnungen gelten überall, wo Text aus dem Editor kommt:
       <strong> setzt Navy und volles Gewicht, <em> bleibt kursiv in
       der Textfarbe. So bleibt Variation möglich, ohne dass es bunt wird. */
    #sb-page-{{ section.id }} strong,
    #sb-page-{{ section.id }} b {
      font-weight: 750;
      color: var(--navy);
    }
    #sb-page-{{ section.id }} .sb-darkzone strong,
    #sb-page-{{ section.id }} .sb-darkzone b { color: #ffffff; }
    #sb-page-{{ section.id }} em,
    #sb-page-{{ section.id }} i { font-style: italic; }

    /* ---------- Sterne ---------- */
    #sb-page-{{ section.id }} .sb-stars { color: var(--gold); font-size: 14px; letter-spacing: 0.07em; }
    #sb-page-{{ section.id }} .sb-tp__box,
    #sb-page-{{ section.id }} .sb-star {
      width: auto; height: auto; background: transparent;
      color: var(--gold); border-radius: 0; font-size: 15px; line-height: 1;
    }
    #sb-page-{{ section.id }} .sb-star:not(.is-on) { background: transparent; color: #DDE2EA; }
    #sb-page-{{ section.id }} .sb-tp__stars,
    #sb-page-{{ section.id }} .sb-swipe--reviews .sb-review__stars { gap: 1px; }

    #sb-page-{{ section.id }} .sb-proof { gap: 11px; margin-bottom: 18px; }
    #sb-page-{{ section.id }} .sb-proof__text { font-size: 13px; color: var(--muted); }
    #sb-page-{{ section.id }} .sb-proof__expert {
      font-size: 12.5px; font-weight: 600; color: #2C3A54;
      border-bottom: 1px solid var(--hair); padding-bottom: 14px;
    }
    #sb-page-{{ section.id }} .sb-proof__expert svg path { stroke: var(--green); stroke-width: 1.9; }

    /* ---------- Trust-Punkte als Chips ----------
       Vorher drei Zeilen untereinander auf Mobil. Jetzt Chips, die
       nebeneinander umbrechen und deutlich weniger Höhe fressen. */
    #sb-page-{{ section.id }} .sb-hero-trust {
      margin-top: 20px;
      gap: 8px;
    }
    #sb-page-{{ section.id }} .sb-hero-trust__item {
      font-size: 12.5px;
      font-weight: 650;
      color: var(--green-deep);
      background: #F1FAF6;
      border: 1px solid rgba(0,182,122,0.24);
      border-radius: 999px;
      padding: 7px 13px 7px 10px;
      gap: 6px;
    }
    #sb-page-{{ section.id }} .sb-hero-trust__item svg { width: 14px; height: 14px; }
    #sb-page-{{ section.id }} .sb-hero-trust__item svg path,
    #sb-page-{{ section.id }} .sb-hero-trust__item svg circle,
    #sb-page-{{ section.id }} .sb-hero-trust__item svg rect {
      stroke: var(--green); stroke-width: 2;
    }

    /* ---------- Versand-/Geschenk-Hinweis ---------- */
    #sb-page-{{ section.id }} .sb-purchase-reward {
      position: relative;
      margin-top: 14px;
      padding: 15px 16px 15px 18px;
      border: 1.5px solid rgba(0,182,122,0.45);
      border-radius: 12px;
      background: #EEFAF5;
      color: #1F4235;
      font-size: 13.5px;
      line-height: 1.45;
      gap: 13px;
      overflow: hidden;
    }
    /* Schmaler Balken links: macht den Kasten auffällig,
       ohne die ganze Fläche lauter zu machen. */
    #sb-page-{{ section.id }} .sb-purchase-reward::before {
      content: '';
      position: absolute; left: 0; top: 0; bottom: 0;
      width: 4px; background: var(--green);
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__text {
      display: grid; gap: 2px; min-width: 0;
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__text strong {
      color: var(--green-deep); font-weight: 800; font-size: 14px;
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__text > span {
      color: #3E6355; font-size: 12.5px;
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__icon {
      width: 34px; height: 34px; flex: 0 0 34px;
      background: var(--green); border-radius: 9px; color: #ffffff;
    }
    #sb-page-{{ section.id }} .sb-purchase-reward__icon svg { width: 18px; height: 18px; stroke-width: 1.8; }

    /* ---------- Knappheit ---------- */
    #sb-page-{{ section.id }} .sb-scarcity { margin-top: 14px; font-size: 13px; font-weight: 600; color: #2C3A54; }
    #sb-page-{{ section.id }} .sb-scarcity__pulse {
      width: 7px; height: 7px; background: var(--red);
      box-shadow: 0 0 0 3px rgba(215,0,21,0.12); animation: none; margin-right: 9px;
    }
    #sb-page-{{ section.id }} .sb-scarcity strong { color: var(--red); font-weight: 700; font-variant-numeric: tabular-nums; }

    /* ---------- Buttons ---------- */
    #sb-page-{{ section.id }} .sb-btn {
      border-radius: 10px; font-size: 15.5px; font-weight: 700;
      min-height: 58px; transition: background 0.18s ease;
    }
    #sb-page-{{ section.id }} .sb-btn:hover { transform: none; opacity: 1; }
    #sb-page-{{ section.id }} .sb-btn--primary { background: var(--navy); box-shadow: none; }
    #sb-page-{{ section.id }} .sb-btn--primary:hover { background: #143467; }
    #sb-page-{{ section.id }} .sb-btn--light:hover { background: #F1F4F9; }
    #sb-page-{{ section.id }} .sb-trust-line {
      margin-top: 14px; font-size: 12.5px; color: var(--faint); text-align: center;
    }

    /* ---------- Lieferzeit-Grafik ---------- */
    #sb-page-{{ section.id }} .sb-ship {
      margin-top: 16px;
      padding: 16px 14px 14px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: #ffffff;
    }
    #sb-page-{{ section.id }} .sb-ship__track {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      position: relative;
    }
    /* Verbindungslinie hinter den Punkten, nicht durch sie hindurch */
    #sb-page-{{ section.id }} .sb-ship__step {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 6px;
    }
    #sb-page-{{ section.id }} .sb-ship__step::before {
      content: '';
      position: absolute;
      top: 15px;
      left: -50%;
      width: 100%;
      height: 2px;
      background: var(--line);
    }
    #sb-page-{{ section.id }} .sb-ship__step:first-child::before { display: none; }
    #sb-page-{{ section.id }} .sb-ship__step.is-done::before { background: var(--green); }

    #sb-page-{{ section.id }} .sb-ship__dot {
      position: relative; z-index: 1;
      width: 32px; height: 32px; flex: 0 0 32px;
      border-radius: 999px;
      background: #F1F5FA;
      border: 1.5px solid var(--line);
      display: inline-flex; align-items: center; justify-content: center;
    }
    #sb-page-{{ section.id }} .sb-ship__dot svg { width: 16px; height: 16px; }
    #sb-page-{{ section.id }} .sb-ship__dot svg path,
    #sb-page-{{ section.id }} .sb-ship__dot svg circle {
      fill: none; stroke: #7C889D; stroke-width: 1.8;
      stroke-linecap: round; stroke-linejoin: round;
    }
    #sb-page-{{ section.id }} .sb-ship__step.is-done .sb-ship__dot {
      background: var(--green); border-color: var(--green);
    }
    #sb-page-{{ section.id }} .sb-ship__step.is-done .sb-ship__dot svg path {
      stroke: #ffffff; stroke-width: 2.6;
    }

    #sb-page-{{ section.id }} .sb-ship__label {
      font-family: var(--font-display);
      font-size: 12.5px; font-weight: 700; color: var(--navy);
      letter-spacing: -0.01em;
    }
    #sb-page-{{ section.id }} .sb-ship__date {
      font-size: 12px; color: var(--muted); line-height: 1.3;
      font-variant-numeric: tabular-nums;
    }
    #sb-page-{{ section.id }} .sb-ship__note {
      margin: 14px 0 0;
      padding-top: 12px;
      border-top: 1px solid var(--hair);
      text-align: center;
      font-size: 12.5px;
      color: var(--muted);
    }
    #sb-page-{{ section.id }} .sb-ship__note strong {
      color: var(--navy); font-weight: 750; white-space: nowrap;
    }

    /* ---------- Produkt-Strip mit Vergleichspreis ---------- */
    #sb-page-{{ section.id }} .sb-product__media { position: relative; }
    #sb-page-{{ section.id }} .sb-product__badge {
      position: absolute; top: 12px; left: 12px; z-index: 2;
      background: var(--red); color: #ffffff;
      font-family: var(--font-display); font-size: 12px; font-weight: 800;
      letter-spacing: 0.01em; padding: 5px 10px; border-radius: 999px;
    }
    #sb-page-{{ section.id }} .sb-product__price {
      display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 8px;
      font-size: 14px;
    }
    #sb-page-{{ section.id }} .sb-product__from { color: var(--faint); font-size: 12.5px; }
    #sb-page-{{ section.id }} .sb-product__price strong {
      font-family: var(--font-display); font-size: 16px; font-weight: 750;
      color: var(--navy); letter-spacing: -0.015em;
    }
    #sb-page-{{ section.id }} .sb-product__price s { color: var(--faint); font-size: 13.5px; }
    #sb-page-{{ section.id }} .sb-product__save {
      flex: 1 0 100%;
      font-size: 12.5px; font-weight: 700; color: var(--green-deep);
    }

    /* ---------- Featured: Kundenstimme ---------- */
    #sb-page-{{ section.id }} .sb-featured__caption {
      display: inline-flex; align-items: center; gap: 7px;
      margin: 16px 0 0; font-size: 12.5px; font-weight: 650; color: var(--green-deep);
    }
    #sb-page-{{ section.id }} .sb-featured__caption svg { width: 15px; height: 15px; flex: 0 0 auto; }
    #sb-page-{{ section.id }} .sb-featured__caption svg circle { fill: var(--green); stroke: none; }
    #sb-page-{{ section.id }} .sb-featured__caption svg path {
      fill: none; stroke: #ffffff; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round;
    }

    /* ---------- Review-Karten ---------- */
    #sb-page-{{ section.id }} .sb-rev-head { align-items: flex-end; gap: 24px; }
    #sb-page-{{ section.id }} .sb-swipe--reviews .sb-review {
      position: relative; overflow: hidden;
      padding: 24px; border-radius: 14px;
      border: 1px solid var(--line); background: #F9FBFD;
      box-shadow: none; gap: 10px;
    }
    #sb-page-{{ section.id }} .sb-review__quotemark {
      position: absolute; top: 6px; right: 14px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 76px; line-height: 1; color: #E3EAF4;
      pointer-events: none;
    }
    #sb-page-{{ section.id }} .sb-review__title { position: relative; }
    #sb-page-{{ section.id }} .sb-swipe--reviews .sb-review blockquote {
      position: relative; font-size: 14px; line-height: 1.6; color: #46536B;
    }
    #sb-page-{{ section.id }} .sb-review figcaption { padding-top: 15px; border-top: 1px solid var(--line); }
