      "settings": {
        "custom_liquid": "{% comment %} ============================================================\n  SLEEPZLAB – NEWSLETTER + FOOTER (zusammenhängender Verlauf)\n  Teil 1: Newsletter (Verlauf Navy → Tiefnavy)\n  Teil 2: Footer (Tiefnavy, nahtloser Übergang)\n  Beide Teile können zusammen ODER getrennt eingefügt werden –\n  zum Trennen einfach am Marker \"==== TEIL 2 ====\" schneiden.\n============================================================ {% endcomment %}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap\" rel=\"stylesheet\">\n\n<div class=\"sl-news\">\n  <div class=\"sl-news__inner\">\n    <h2 class=\"sl-news__title\">Bleib verbunden.</h2>\n    <p class=\"sl-news__text\">Neue Produkte und Angebote – als Erster, ohne Spam.</p>\n\n    <form class=\"sl-news__form\" method=\"post\" action=\"/contact#sl-news\">\n      <input type=\"hidden\" name=\"form_type\" value=\"customer\">\n      <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter\">\n      <label class=\"sl-visually-hidden\" for=\"sl-news-email\">E-Mail-Adresse</label>\n      <input\n        id=\"sl-news-email\"\n        type=\"email\"\n        name=\"contact[email]\"\n        class=\"sl-news__input\"\n        placeholder=\"E-Mail-Adresse\"\n        autocomplete=\"email\"\n        required\n      >\n      <button type=\"submit\" class=\"sl-news__button\" aria-label=\"Anmelden\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M13 6l6 6-6 6\"/></svg>\n      </button>\n    </form>\n\n    <p class=\"sl-news__hint\">Abmeldung jederzeit möglich.</p>\n  </div>\n</div>\n\n{% comment %} ==== TEIL 2: FOOTER ==== {% endcomment %}\n\n<div class=\"sl-foot\">\n  <div class=\"sl-foot__inner\">\n\n    <h2 class=\"sl-foot__title\">SleepzLab</h2>\n    <p class=\"sl-foot__text\">Qualität. Fokus. Ruhigere Morgen.</p>\n\n    <nav class=\"sl-foot__links\" aria-label=\"Rechtliches\">\n      <a href=\"{{ shop.legal_notice.url }}\">Impressum</a>\n      <a href=\"{{ shop.privacy_policy.url }}\">Datenschutz</a>\n      <a href=\"{{ shop.terms_of_service.url }}\">AGB</a>\n      <a href=\"{{ shop.refund_policy.url }}\">Widerrufsrecht</a>\n      <a href=\"{{ shop.shipping_policy.url }}\">Versand</a>\n      <a href=\"/pages/kontakt\">Kontakt</a>\n    </nav>\n\n    <div class=\"sl-foot__divider\" aria-hidden=\"true\"></div>\n\n    <div class=\"sl-foot__withdraw\">\n      <span>Bestellung widerrufen?</span>\n      <a href=\"/pages/vertrag-widerrufen\">Vertrag widerrufen</a>\n    </div>\n\n    <p class=\"sl-foot__copy\">© {{ 'now' | date: \"%Y\" }} SleepzLab · Alle Rechte vorbehalten</p>\n  </div>\n</div>\n\n<style>\n  /* ============ Gemeinsame Basis ============ */\n  .sl-news, .sl-foot {\n    --sl-navy: #0B2350;\n    --sl-deep: #071835;\n    --sl-line: rgba(255,255,255,0.10);\n    --sl-dim: rgba(255,255,255,0.66);\n    --sl-faint: rgba(255,255,255,0.42);\n    --sl-font-display: 'Sora', -apple-system, sans-serif;\n    --sl-font-body: 'Inter', -apple-system, sans-serif;\n    position: relative;\n    left: 50%;\n    margin-left: -50vw;\n    width: 100vw;\n    color: #ffffff;\n    font-family: var(--sl-font-body);\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .sl-visually-hidden {\n    position: absolute !important;\n    width: 1px; height: 1px;\n    margin: -1px; padding: 0; border: 0;\n    clip: rect(0 0 0 0); overflow: hidden;\n  }\n\n  /* ============ Newsletter ============ */\n  .sl-news {\n    background: linear-gradient(180deg, var(--sl-navy) 0%, var(--sl-deep) 100%);\n    padding: 104px 20px 88px;\n  }\n\n  .sl-news__inner {\n    max-width: 560px;\n    margin: 0 auto;\n    text-align: center;\n  }\n\n  .sl-news__title {\n    margin: 0;\n    font-family: var(--sl-font-display);\n    font-size: clamp(32px, 4.5vw, 44px);\n    font-weight: 700;\n    letter-spacing: -0.03em;\n    line-height: 1.05;\n  }\n\n  .sl-news__text {\n    margin: 12px 0 0;\n    font-size: 15.5px;\n    line-height: 1.6;\n    color: var(--sl-dim);\n  }\n\n  .sl-news__form {\n    margin: 34px auto 0;\n    max-width: 420px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    border-bottom: 1px solid rgba(255,255,255,0.28);\n    padding-bottom: 8px;\n    transition: border-color 0.2s ease;\n  }\n  .sl-news__form:focus-within { border-bottom-color: #ffffff; }\n\n  .sl-news__input {\n    flex: 1;\n    min-width: 0;\n    border: none !important;\n    outline: none !important;\n    background: transparent !important;\n    background-color: transparent !important;\n    color: #ffffff !important;\n    font-family: var(--sl-font-body);\n    font-size: 16px;\n    padding: 10px 0;\n    box-shadow: none !important;\n    -webkit-appearance: none !important;\n    appearance: none !important;\n    border-radius: 0 !important;\n  }\n  .sl-news__input::placeholder { color: var(--sl-faint); }\n  .sl-news__input:-webkit-autofill {\n    -webkit-text-fill-color: #ffffff;\n    transition: background-color 9999s ease-in-out 0s;\n  }\n\n  .sl-news__button {\n    flex: 0 0 auto;\n    width: 44px;\n    height: 44px;\n    border-radius: 999px;\n    border: 1px solid rgba(255,255,255,0.30);\n    background: transparent;\n    color: #ffffff;\n    cursor: pointer;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;\n  }\n  .sl-news__button svg {\n    width: 18px; height: 18px;\n  }\n  .sl-news__button svg path {\n    fill: none; stroke: currentColor; stroke-width: 2;\n    stroke-linecap: round; stroke-linejoin: round;\n  }\n  .sl-news__button:hover {\n    background: #ffffff;\n    color: var(--sl-deep);\n    transform: translateX(2px);\n  }\n  .sl-news__button:focus-visible {\n    outline: 2px solid #ffffff;\n    outline-offset: 3px;\n  }\n\n  .sl-news__hint {\n    margin: 16px 0 0;\n    font-size: 12px;\n    color: var(--sl-faint);\n  }\n\n  /* ============ Footer (nahtlos anschließend) ============ */\n  .sl-foot {\n    background: var(--sl-deep);\n    padding: 20px 20px 56px;\n  }\n\n  .sl-foot__inner {\n    max-width: 700px;\n    margin: 0 auto;\n    text-align: center;\n    border-top: 1px solid var(--sl-line);\n    padding-top: 56px;\n  }\n\n  .sl-foot__title {\n    margin: 0;\n    font-family: var(--sl-font-display);\n    font-size: 26px;\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n\n  .sl-foot__text {\n    margin: 8px 0 0;\n    font-size: 13.5px;\n    color: var(--sl-dim);\n    letter-spacing: 0.01em;\n  }\n\n  .sl-foot__links {\n    margin-top: 32px;\n    display: flex;\n    justify-content: center;\n    flex-wrap: wrap;\n    column-gap: 26px;\n    row-gap: 12px;\n  }\n  .sl-foot__links a {\n    color: var(--sl-dim);\n    text-decoration: none;\n    font-size: 13.5px;\n    font-weight: 500;\n    transition: color 0.15s ease;\n  }\n  .sl-foot__links a:hover { color: #ffffff; }\n  .sl-foot__links a:focus-visible {\n    outline: 2px solid #ffffff;\n    outline-offset: 3px;\n    border-radius: 2px;\n  }\n\n  .sl-foot__divider {\n    margin: 34px auto 0;\n    width: 44px;\n    height: 1px;\n    background: var(--sl-line);\n  }\n\n  .sl-foot__withdraw {\n    margin-top: 26px;\n    font-size: 12.5px;\n    color: var(--sl-faint);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 8px;\n    flex-wrap: wrap;\n  }\n  .sl-foot__withdraw a {\n    color: #ffffff;\n    font-size: 12.5px;\n    font-weight: 600;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n    text-decoration-color: rgba(255,255,255,0.4);\n    transition: text-decoration-color 0.15s ease;\n  }\n  .sl-foot__withdraw a:hover { text-decoration-color: #ffffff; }\n\n  .sl-foot__copy {\n    margin: 22px 0 0;\n    font-size: 12px;\n    color: var(--sl-faint);\n  }\n\n  /* ============ Mobile ============ */\n  @media screen and (max-width: 749px) {\n    .sl-news { padding: 72px 20px 60px; }\n    .sl-news__title { font-size: 30px; }\n    .sl-news__text { font-size: 14.5px; }\n    .sl-news__form { margin-top: 28px; max-width: 100%; }\n    .sl-news__button { width: 42px; height: 42px; }\n\n    .sl-foot { padding: 14px 20px 44px; }\n    .sl-foot__inner { padding-top: 44px; }\n    .sl-foot__title { font-size: 23px; }\n    .sl-foot__links {\n      margin-top: 26px;\n      column-gap: 18px;\n      row-gap: 12px;\n    }\n    .sl-foot__links a { font-size: 13px; padding: 4px 0; }\n    .sl-foot__divider { margin-top: 28px; }\n    .sl-foot__withdraw { margin-top: 22px; font-size: 12px; }\n    .sl-foot__copy { margin-top: 18px; font-size: 11.5px; }\n  }\n</style>",
